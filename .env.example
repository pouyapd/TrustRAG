# LLM provider for the service: openai | anthropic
# (the config also accepts ollama, but the service has no Ollama client yet)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Models
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Ollama: read by the config, not used by the service yet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=trustrag_docs

# RAG settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=4

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
